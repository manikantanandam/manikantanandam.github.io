{
  "id": "single-number",
  "title": "Single Number",
  "difficulty": "Easy",
  "tags": [
    "xor"
  ],
  "summary": "Every element appears twice except one; find it in O(1) space.",
  "approach": "XOR all numbers: pairs cancel (x ^ x = 0) and 0 ^ y = y.",
  "complexity": "O(n) time, O(1) space",
  "body": [],
  "code": [],
  "solution": [
    {
      "lang": "swift",
      "caption": "Solution",
      "text": "func singleNumber(_ nums: [Int]) -> Int {\n    nums.reduce(0, ^)\n}"
    }
  ],
