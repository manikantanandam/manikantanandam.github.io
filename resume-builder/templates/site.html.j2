{#- Renders index.html. Edit content in data.yaml / overrides/site.yaml, then run: python3 resume-builder/build.py site -#}
{% macro icon(name) -%}
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
{%- if name == 'download' %}<path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14"/>
{%- elif name == 'mail' %}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
{%- elif name == 'phone' %}<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>
{%- elif name == 'chat' %}<path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.6A8.4 8.4 0 1 1 21 11.5z"/>
{%- elif name == 'github' %}<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3.1-.4 6.4-1.5 6.4-7A5.4 5.4 0 0 0 20 4.8 5 5 0 0 0 19.9 1S18.7.6 16 2.5a13.4 13.4 0 0 0-7 0C6.3.6 5.1 1 5.1 1A5 5 0 0 0 5 4.8a5.4 5.4 0 0 0-1.5 3.7c0 5.4 3.3 6.6 6.4 7a3.4 3.4 0 0 0-.9 2.6V22"/>
{%- elif name == 'linkedin' %}<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
{%- elif name == 'external' %}<path d="M7 17 17 7M8 7h9v9"/>
{%- elif name == 'copy' %}<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/>
{%- elif name == 'pin' %}<path d="M12 22s7-6.3 7-12a7 7 0 0 0-14 0c0 5.7 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/>
{%- elif name == 'sun' %}<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
{%- elif name == 'moon' %}<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
{%- elif name == 'menu' %}<path d="M4 7h16M4 12h16M4 17h16"/>
{%- elif name == 'close' %}<path d="M6 6l12 12M18 6 6 18"/>
{%- endif -%}
</svg>
{%- endmacro %}
<!doctype html>
<!-- GENERATED by resume-builder/build.py from templates/site.html.j2 - do not edit. -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ seo.title }}</title>
  <meta name="description" content="{{ seo.description | trim }}">
  <meta name="author" content="{{ name }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ site_url }}">
  <meta property="og:type" content="profile">
  <meta property="og:site_name" content="{{ name }}">
  <meta property="og:title" content="{{ seo.title }}">
  <meta property="og:description" content="{{ seo.description | trim }}">
  <meta property="og:url" content="{{ site_url }}">
  <meta property="og:image" content="{{ site_url }}{{ photo }}">
  <meta property="og:image:alt" content="Portrait of {{ name }}">
  <meta property="profile:first_name" content="{{ name.split(' ')[0] }}">
  <meta property="profile:last_name" content="{{ name.split(' ')[-1] }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ seo.title }}">
  <meta name="twitter:description" content="{{ seo.description | trim }}">
  <meta name="twitter:image" content="{{ site_url }}{{ photo }}">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0b0f17" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%231d4ed8'/><text x='32' y='42' font-family='Arial' font-weight='700' font-size='26' fill='white' text-anchor='middle'>{{ initials }}</text></svg>">
  <script>
    // Apply saved theme / text size before paint to avoid a flash.
    (function () {
      var r = document.documentElement;
      r.className = 'js';
      try {
        var t = localStorage.getItem('theme');
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        r.setAttribute('data-theme', t);
        var s = localStorage.getItem('fontScale');
        if (s) r.style.setProperty('--font-scale', s);
      } catch (e) {
        r.setAttribute('data-theme', 'light');
      }
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="style.css">
  <script type="application/ld+json">
{{ json_ld | safe }}
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="nav">
    <nav class="container" aria-label="Primary">
      <a class="brand" href="#top"><span class="brand-mark" aria-hidden="true">{{ initials }}</span><span class="brand-name">{{ name }}</span></a>
      <button type="button" id="menu-toggle" class="icon-btn" aria-expanded="false" aria-controls="menu" aria-label="Open menu">{{ icon('menu') }}{{ icon('close') }}</button>
      <div class="nav-panel">
        <ul id="menu">
          <li><a href="#about">About</a></li>
          <li><a href="#experience">Experience</a></li>
          <li><a href="#projects">Work</a></li>
          <li><a href="#knowledge">Knowledge</a></li>
          <li><a href="#skills">Skills</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
        <div class="controls">
          <button type="button" class="icon-btn" id="font-down" aria-label="Decrease text size">A−</button>
          <button type="button" class="icon-btn" id="font-up" aria-label="Increase text size">A+</button>
          <button type="button" class="icon-btn" id="theme-toggle" aria-pressed="false" aria-label="Switch to dark theme">{{ icon('moon') }}{{ icon('sun') }}</button>
          <a class="btn btn-primary btn-sm" href="#contact">Hire me</a>
        </div>
      </div>
    </nav>
  </header>

  <main id="main">
    <section class="hero container" id="top">
      <div class="hero-text">
        <p class="pill"><span class="dot" aria-hidden="true"></span>{{ availability }}</p>
        <h1>{{ name }}<span class="h1-role">{{ title }}</span></h1>
        <p class="headline">{{ headline }}</p>
        <p class="lead">{{ tagline | trim }}</p>
        <div class="cta-row">
          {% for r in resumes %}
          <a class="btn {{ 'btn-primary' if loop.first else 'btn-outline' }}" href="{{ r.file }}" target="_blank" rel="noopener">{{ icon('download') }}{{ r.label }}</a>
          {% endfor %}
        </div>
        <ul class="meta-row">
          <li>{{ icon('pin') }}{{ location }}</li>
          {% if github %}<li><a href="{{ github }}" target="_blank" rel="noopener me">{{ icon('github') }}GitHub</a></li>{% endif %}
          {% if linkedin %}<li><a href="{{ linkedin }}" target="_blank" rel="noopener me">{{ icon('linkedin') }}LinkedIn</a></li>{% endif %}
          <li><a href="{{ mailto }}">{{ icon('mail') }}{{ email }}</a></li>
        </ul>
      </div>
      <figure class="hero-photo">
        <img src="{{ photo }}" alt="Portrait of {{ name }}, {{ title }}" width="420" height="420" fetchpriority="high">
      </figure>
    </section>

    <section class="container highlights" aria-label="Highlights">
      <dl>
        {% for h in highlights %}
        <div class="reveal"><dt>{{ h.value }}</dt><dd>{{ h.label }}</dd></div>
        {% endfor %}
      </dl>
    </section>

    <section class="container section split" id="about">
      <header class="section-head">
        <p class="eyebrow">About</p>
        <h2>Product-minded iOS engineer</h2>
      </header>
      <div class="reveal">
        <p class="prose">{{ summary }}</p>
        <p class="muted">
          {% for ed in education %}{{ ed.degree }}, {{ ed.school }} ({{ ed.start }}–{{ ed.end }}){% endfor %}
        </p>
      </div>
    </section>

    <section class="container section" id="experience">
      <header class="section-head">
        <p class="eyebrow">Experience</p>
        <h2>{{ total_experience.split(' (')[0] }} of building mobile apps</h2>
      </header>
      <ol class="timeline">
        {% for e in experience %}
        <li class="reveal">
          <p class="when"><time datetime="{{ e.start }}">{{ e.period.split(' - ')[0] }}</time> – {% if e.end == 'present' %}Present{% else %}<time datetime="{{ e.end }}">{{ e.period.split(' - ')[1] }}</time>{% endif %}</p>
          <div>
            <h3>{{ e.role }}</h3>
            <p class="org">{{ e.company }} · {{ e.location }}</p>
            <ul>
              {% for p in e.points %}<li>{{ p }}</li>
              {% endfor %}
            </ul>
          </div>
        </li>
        {% endfor %}
      </ol>
    </section>

    <section class="container section" id="projects">
      <header class="section-head">
        <p class="eyebrow">Selected work</p>
        <h2>Apps I've built and shipped</h2>
      </header>
      <div class="grid">
        {% for p in projects %}
        <article class="card reveal">
          <h3>{{ p.name }}</h3>
          <p>{{ p.description }}</p>
          {% if p.points %}
          <ul>
            {% for pt in p.points %}<li>{{ pt }}</li>
            {% endfor %}
          </ul>
          {% endif %}
          <ul class="tags" aria-label="Technologies">
            {% for t in p.tags %}<li>{{ t }}</li>{% endfor %}
          </ul>
          {% if p.link %}<a class="card-link" href="{{ p.link }}" target="_blank" rel="noopener">View project{{ icon('external') }}</a>{% endif %}
        </article>
        {% endfor %}
      </div>
    </section>

    <section class="container section" id="knowledge">
      <header class="section-head">
        <p class="eyebrow">Knowledge</p>
        <h2>Notes and practice I keep up to date</h2>
      </header>
      <div class="grid">
        {% for k in knowledge %}
        <a class="card kb-card reveal" href="{{ k.href }}">
          <h3>{{ k.title }}</h3>
          <p>{{ k.desc }}</p>
          <span class="kb-card-link">Open {{ icon('external') }}</span>
        </a>
        {% endfor %}
      </div>
    </section>

    <section class="container section" id="skills">
      <header class="section-head">
        <p class="eyebrow">Skills</p>
        <h2>iOS tech stack</h2>
      </header>
      <div class="skills">
        {% for s in skills %}
        <div class="skill-group reveal">
          <h3>{{ s.title }}</h3>
          <ul class="tags">
            {% for i in s['items'] %}<li>{{ i }}</li>{% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </section>

    <section class="container section" id="contact">
      <div class="contact-card reveal">
        <p class="eyebrow">Contact</p>
        <h2>Hiring a senior iOS developer?</h2>
        <p class="lead">I'd love to hear about the role. WhatsApp gets the fastest reply; email and phone work too.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="{{ wa_url }}" target="_blank" rel="noopener">{{ icon('chat') }}Chat on WhatsApp</a>
          <a class="btn btn-outline" href="{{ mailto }}">{{ icon('mail') }}Email me</a>
          <button type="button" class="btn btn-ghost" id="copy-email" data-email="{{ email }}">{{ icon('copy') }}Copy email</button>
          <a class="btn btn-ghost" href="tel:{{ phone }}">{{ icon('phone') }}Call</a>
        </div>
        <p id="copy-status" class="muted" role="status" aria-live="polite"></p>
      </div>
    </section>
  </main>

  <footer class="container footer">
    <p>© {{ name }} · {{ title }} · {{ location }}</p>
    <p><a href="#top">Back to top ↑</a></p>
  </footer>

  <a class="fab" href="{{ wa_url }}" aria-label="Chat on WhatsApp" target="_blank" rel="noopener">{{ icon('chat') }}</a>

  <script src="script.js"></script>
</body>
</html>
